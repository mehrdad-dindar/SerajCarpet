{
    "name": "mehrdad-dindar/filament-porsline",
    "description": "A FilamentPHP package for integrating Porsline survey API",
    "type": "library",
    "license": "MIT",
    "version": "0.0.1",
    "authors": [
        {
            "name": "Mehrdad Dindar",
            "email": "mehrdad.replay@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "spatie/laravel-package-tools": "^1.92.7"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MehrdadDindar\\FilamentPorsline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MehrdadDindar\\FilamentPorsline\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MehrdadDindar\\FilamentPorsline\\FilamentPorslineServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
} 