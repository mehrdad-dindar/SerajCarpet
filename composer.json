{
    "name": "mehrdad-dindar/seraj",
    "type": "project",
    "version": "1.0.41",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-soap": "*",
        "awcodes/filament-table-repeater": "^3.0",
        "awcodes/overlook": "^2.2",
        "bezhansalleh/filament-language-switch": "^3.1",
        "bezhansalleh/filament-shield": "^3.2",
        "dotswan/filament-map-picker": "^1.8.0",
        "filament/filament": "^3.2",
        "filament/notifications": "^3.2",
        "filament/spatie-laravel-media-library-plugin": "^3.2",
        "filament/spatie-laravel-settings-plugin": "^3.2",
        "hashids/hashids": "^5.0",
        "hekmatinasser/verta": "^8.4",
        "jantinnerezo/livewire-alert": "^3.0",
        "laravel/framework": "^11.0",
        "laravel/jetstream": "^5.1",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.5",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^v3.5.19",
        "mokhosh/filament-jalali": "^3.5",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-livewire-wizard": "^2.3",
        "spatie/laravel-medialibrary": "^11.12",
        "wireui/breadcrumbs": "^3.1",
        "wireui/phosphoricons": "^2.3",
        "wireui/wireui": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.64",
        "fruitcake/laravel-telescope-toolbar": "^1.3",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0.1",
        "spatie/laravel-ignition": "^2.4",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/utils.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan vendor:publish --tag=livewire:assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
